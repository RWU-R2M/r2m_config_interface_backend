PORT=5000
FLASK_DEBUG=True

# API Route Configurations
# Set to "true" to enable, "false" to disable

# System Status Endpoint (/)
ENABLE_STATUS_ENDPOINT=true

# System Information Endpoint (/api/system)
ENABLE_SYSTEM_ENDPOINT=true

# Docker Containers Information Endpoint (/api/docker)
ENABLE_DOCKER_ENDPOINT=true

# Command Execution Endpoint (/api/execute)
ENABLE_COMMAND_ENDPOINT=true

# Script Endpoints (/api/scripts and /api/scripts/<script_name>)
ENABLE_SCRIPTS_ENDPOINT=true

# Process Management Endpoints (/api/processes and /api/processes/<process_id>)
ENABLE_PROCESSES_ENDPOINT=true

# Security Settings
# Command execution whitelist (comma-separated list of allowed commands)
# Empty value means no restrictions (not recommended for production)
COMMAND_WHITELIST=ls,df,ps,free,top,docker,cat,echo,hostname,cd

# Maximum timeout for command execution in seconds
COMMAND_MAX_TIMEOUT=60

# Maximum timeout for script execution in seconds
SCRIPT_MAX_TIMEOUT=60